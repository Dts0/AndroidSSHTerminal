<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/hostListFragment">

    <fragment
        android:id="@+id/hostListFragment"
        android:name="com.sshtool.ui.hostlist.HostListFragment"
        android:label="@string/host_list_title"
        tools:layout="@layout/fragment_host_list">
        
        <action
            android:id="@+id/action_hostList_to_editor"
            app:destination="@id/hostEditorFragment" />
        
        <action
            android:id="@+id/action_hostList_to_terminal"
            app:destination="@id/terminalFragment" />

        <action
            android:id="@+id/action_hostList_to_about"
            app:destination="@id/aboutFragment" />
    </fragment>

    <fragment
        android:id="@+id/hostEditorFragment"
        android:name="com.sshtool.ui.editor.HostEditorFragment"
        android:label="@string/edit_host"
        tools:layout="@layout/fragment_host_editor">
        
        <argument
            android:name="hostId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/terminalFragment"
        android:name="com.sshtool.ui.terminal.TerminalFragment"
        android:label="@string/terminal_title"
        tools:layout="@layout/fragment_terminal">
        
        <argument
            android:name="hostId"
            app:argType="long"
            android:defaultValue="-1L" />

        <action
            android:id="@+id/action_terminal_to_fileTransfer"
            app:destination="@id/fileTransferFragment" />
    </fragment>

    <fragment
        android:id="@+id/fileTransferFragment"
        android:name="com.sshtool.ui.filetransfer.FileTransferFragment"
        android:label="@string/file_transfer_title"
        tools:layout="@layout/fragment_file_transfer">

        <argument
            android:name="sessionId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.sshtool.ui.about.AboutFragment"
        android:label="@string/about_title"
        tools:layout="@layout/fragment_about" />

</navigation>
