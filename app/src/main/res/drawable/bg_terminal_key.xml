<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#334FC3F7">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#252A31" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="#3D6175" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="#185C7C" />
                    <stroke android:width="1dp" android:color="#4FC3F7" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#343B45" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
