<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#1E2228"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terminal_back_desc"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@android:color/white" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:tabIconTint="@null"
            app:tabIndicatorColor="#4FC3F7"
            app:tabInlineLabel="true"
            app:tabMinWidth="72dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabRippleColor="#33FFFFFF"
            app:tabSelectedTextColor="@android:color/white"
            app:tabTextAppearance="@style/TextAppearance.SSHTerminal.Tab"
            app:tabTextColor="#B6BDC7" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_add_session"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_ssh_session_desc"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_add"
            app:tint="@android:color/white" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/terminal_actions_desc"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_more_vert"
            app:tint="@android:color/white" />
    </LinearLayout>

    <com.termux.view.TerminalView
        android:id="@+id/terminal_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_bar" />

    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1E2228"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_ctrl"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/key_ctrl" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_tab"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_tab" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_esc"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_esc" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_paste"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_paste" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_pgup"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_pgup" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_up"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_up_desc"
                android:text="@string/key_up" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_pgdn"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_pgdn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_home"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/key_home" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_end"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/key_end" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_del"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_del_desc"
                android:text="@string/key_del" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_enter"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_enter_desc"
                android:text="@string/key_enter" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_left"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_left_desc"
                android:text="@string/key_left" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_down"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_down_desc"
                android:text="@string/key_down" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_right"
                style="@style/Widget.SSHTerminal.ExtraKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/key_right_desc"
                android:text="@string/key_right" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
